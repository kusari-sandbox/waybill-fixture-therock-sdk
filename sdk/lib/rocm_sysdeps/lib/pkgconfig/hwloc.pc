prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}/include

Name: hwloc
Description: Hardware locality detection and management library
Version: 1.11.13
Requires.private: pciaccess 
Cflags: -I${includedir}
Libs: -L${libdir} -lhwloc
Libs.private: -lm  -lnuma  -lpciaccess   -lpthread
