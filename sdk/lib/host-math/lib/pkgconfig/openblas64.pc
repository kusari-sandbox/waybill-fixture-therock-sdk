libdir=/home/runner/_work/TheRock/TheRock/output/build/third-party/host-blas/host-blas64/stage/lib/host-math/lib
libnameprefix=
libnamesuffix=
libsuffix=_64
includedir=/home/runner/_work/TheRock/TheRock/output/build/third-party/host-blas/host-blas64/stage/lib/host-math/include/openblas64

openblas_config=USE_64BITINT=1 NO_CBLAS= NO_LAPACK= NO_LAPACKE= DYNAMIC_ARCH=ON DYNAMIC_OLDER=OFF NO_AFFINITY=ON USE_OPENMP= HASWELL MAX_THREADS=64 
Name: OpenBLAS
Description: OpenBLAS is an optimized BLAS library based on GotoBLAS2 1.13 BSD version
Version: 0.3.31.dev
URL: https://github.com/OpenMathLib/OpenBLAS
Libs: -L${libdir} -l${libnameprefix}openblas${libnamesuffix}${libsuffix} 
Cflags: -I${includedir}  
